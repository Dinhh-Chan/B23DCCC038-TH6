{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email'])"
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('senderId').val() === auth.uid && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
          ".validate": "newData.hasChildren(['senderId', 'type', 'createdAt'])"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)"
        }
      }
    }
  }
}
